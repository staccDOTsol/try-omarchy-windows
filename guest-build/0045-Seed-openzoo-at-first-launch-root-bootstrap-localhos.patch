@@ -0,0 +1,24 @@
+#!/bin/bash
+# First-boot openzoo bootstrap: Node and the openzoo CLI, installed ONCE from
+# the network on the first online boot, so the locked factory package set
+# stays exactly what the build verified. The stamp file is the only state; a
+# boot without network simply tries again next time. After this every user
+# session gets a local x402 proxy on :8402 (openzoo-proxy.service), and the
+# seeded ~/.codex/config.toml makes the Codex side of OpenAI's ChatGPT desktop
+# app pay per turn through it.
+set -euo pipefail
+
+stamp=/var/lib/try-omarchy/openzoo-bootstrapped
+[[ -e $stamp ]] && exit 0
+
+if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
+  pacman -Sy --needed --noconfirm nodejs npm
+fi
+if ! command -v openzoo >/dev/null 2>&1; then
+  npm install -g --no-fund --no-audit openzoo
+fi
+command -v openzoo >/dev/null 2>&1 || { echo "openzoo did not install" >&2; exit 1; }
+
+mkdir -p "$(dirname "$stamp")"
+: >"$stamp"
+echo "openzoo bootstrap complete: $(command -v openzoo)"
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/openzoo-first-launch b/guest/factory-overlay/usr/local/lib/try-omarchy/openzoo-first-launch
new file mode 100755
index 0000000..f37e155
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/openzoo-first-launch
@@ -0,0 +1,29 @@
+#!/bin/bash
+# First login: openzoo, all of it, from the same one-liner a real Omarchy box
+# runs — `curl -fsSL openzoo.fun/omarchymax | bash` (the agent in Omarchy's
+# agent list, the bar widget, local ingest, and the ChatGPT desktop seed).
+# Runs as the user in the graphical session, once, and only after the root
+# bootstrap has put Node and the openzoo CLI in place. A boot without network
+# leaves no stamp and tries again at the next login. Nothing here is
+# interactive: the installer skips its final "start the agent" handoff when
+# stdout is not a terminal.
+set -u
+
+stamp="$HOME/.openzoo/omarchymax-done"
+[[ -e $stamp ]] && exit 0
+mkdir -p "$HOME/.openzoo"
+
+for _ in $(seq 1 24); do
+  [[ -x /usr/bin/openzoo ]] && break
+  sleep 5
+done
+[[ -x /usr/bin/openzoo ]] || { echo "openzoo CLI not installed yet (root bootstrap pending)" >&2; exit 1; }
+
+log="$HOME/.openzoo/omarchymax-first-launch.log"
+if curl -fsSL --retry 5 --retry-delay 3 https://openzoo.fun/omarchymax | bash >>"$log" 2>&1; then
+  : >"$stamp"
+  notify-send -a openzoo "openzoo is in" "Super+Shift+Z asks any model. ChatGPT desktop's Codex side pays per call too — try-omarchy-chatgpt --deb <file>." 2>/dev/null || true
+  exit 0
+fi
+echo "openzoo.fun/omarchymax did not complete — see $log; retried at next login" >&2
+exit 1
