diff --git a/guest/tests/test_openzoo.py b/guest/tests/test_openzoo.py
new file mode 100644
index 0000000..b536ac9
--- /dev/null
+++ b/guest/tests/test_openzoo.py
@@ -0,0 +1,133 @@
+"""Contract tests for the openzoo seed: Node and the openzoo CLI arrive on the
+first online boot through a root oneshot, every user session runs a
+localhost-only x402 proxy, and the first graphical login runs the
+openzoo.fun/omarchymax one-liner once. The locked factory package set must
+stay untouched, which is the whole point of doing this at boot instead of at
+build time."""
+
+from __future__ import annotations
+
+import os
+import re
+import stat
+import unittest
+from pathlib import Path
+
+GUEST = Path(__file__).resolve().parents[1]
+OVERLAY = GUEST / "factory-overlay"
+LIB = OVERLAY / "usr/local/lib/try-omarchy"
+
+BOOTSTRAP = LIB / "openzoo-bootstrap"
+FIRST_LAUNCH = LIB / "openzoo-first-launch"
+CHATGPT = OVERLAY / "usr/local/bin/try-omarchy-chatgpt"
+
+BOOTSTRAP_UNIT = OVERLAY / "etc/systemd/system/try-omarchy-openzoo-bootstrap.service"
+PROXY_UNIT = OVERLAY / "etc/systemd/user/openzoo-proxy.service"
+FIRST_LAUNCH_UNIT = OVERLAY / "etc/systemd/user/openzoo-first-launch.service"
+
+BOOTSTRAP_WANT = OVERLAY / "etc/systemd/system/multi-user.target.wants/try-omarchy-openzoo-bootstrap.service"
+PROXY_WANT = OVERLAY / "etc/systemd/user/default.target.wants/openzoo-proxy.service"
+FIRST_LAUNCH_WANT = OVERLAY / "etc/systemd/user/graphical-session.target.wants/openzoo-first-launch.service"
+
+CODEX_CONFIG = OVERLAY / "etc/skel/.codex/config.toml"
+ENVIRONMENT_CONF = OVERLAY / "usr/lib/environment.d/91-openzoo.conf"
+PACKAGES = GUEST / "packages.txt"
+
+
+def read(path: Path) -> str:
+    return path.read_text(encoding="utf-8")
+
+
+def has_line(text: str, line: str) -> bool:
+    return re.search(r"(?m)^" + re.escape(line) + r"\s*$", text) is not None
+
+
+class ScriptTests(unittest.TestCase):
+    def test_scripts_are_executable_bash(self) -> None:
+        for script in (BOOTSTRAP, FIRST_LAUNCH, CHATGPT):
+            with self.subTest(script=script.name):
+                self.assertTrue(script.is_file())
+                self.assertTrue(script.stat().st_mode & stat.S_IXUSR)
+                self.assertTrue(os.access(script, os.X_OK))
+                self.assertTrue(read(script).startswith("#!/bin/bash\n"))
+
+    def test_locked_package_set_is_untouched(self) -> None:
+        names = {line.strip() for line in read(PACKAGES).splitlines()}
+        self.assertNotIn("nodejs", names)
+        self.assertNotIn("npm", names)
+        self.assertNotIn("openzoo", names)
+
+    def test_bootstrap_installs_node_and_openzoo_then_stamps(self) -> None:
+        text = read(BOOTSTRAP)
+        self.assertRegex(text, r"(?m)^\s*pacman -Sy\b.*\bnodejs\b.*\bnpm\b")
+        self.assertRegex(text, r"(?m)^\s*npm install -g\b.*\bopenzoo\b")
+        self.assertIn("/var/lib/try-omarchy/openzoo-bootstrapped", text)
+
+    def test_first_launch_runs_the_omarchymax_one_liner_once(self) -> None:
+        text = read(FIRST_LAUNCH)
+        self.assertIn("https://openzoo.fun/omarchymax", text)
+        self.assertRegex(text, r"curl -fsSL\b.*https://openzoo\.fun/omarchymax \| bash")
+        self.assertIn("/usr/bin/openzoo", text)
+        self.assertIn(".openzoo/omarchymax-done", text)
+
+    def test_chatgpt_wrapper_points_at_the_download_page_and_ships_no_deb(self) -> None:
+        text = read(CHATGPT)
+        self.assertIn("https://chatgpt.com/download", text)
+        self.assertIn("openzoo chatgpt", text)
+        self.assertIn("--deb", text)
+        self.assertNotRegex(text, r"https?://\S+\.deb\b")
+
+
+class UnitTests(unittest.TestCase):
+    def test_bootstrap_unit_is_a_first_online_boot_oneshot(self) -> None:
+        text = read(BOOTSTRAP_UNIT)
+        self.assertTrue(has_line(text, "Type=oneshot"))
+        self.assertTrue(has_line(text, "ExecStart=/usr/local/lib/try-omarchy/openzoo-bootstrap"))
+        self.assertTrue(has_line(text, "ConditionPathExists=!/var/lib/try-omarchy/openzoo-bootstrapped"))
+        self.assertTrue(has_line(text, "WantedBy=multi-user.target"))
+        self.assertTrue(has_line(text, "After=network-online.target"))
+
+    def test_proxy_unit_serves_localhost_only(self) -> None:
+        text = read(PROXY_UNIT)
+        self.assertTrue(has_line(text, "ExecStart=/usr/bin/openzoo proxy"))
+        self.assertTrue(has_line(text, "Environment=OPENZOO_NO_TUNNEL=1"))
+        self.assertTrue(has_line(text, "WantedBy=default.target"))
+        self.assertIn("localhost:8402", text)
+
+    def test_first_launch_unit_runs_once_per_user_in_the_graphical_session(self) -> None:
+        text = read(FIRST_LAUNCH_UNIT)
+        self.assertTrue(has_line(text, "Type=oneshot"))
+        self.assertTrue(has_line(text, "ExecStart=/usr/local/lib/try-omarchy/openzoo-first-launch"))
+        self.assertTrue(has_line(text, "ConditionPathExists=!%h/.openzoo/omarchymax-done"))
+        self.assertTrue(has_line(text, "WantedBy=graphical-session.target"))
+
+    def test_wants_symlinks_resolve_to_the_units(self) -> None:
+        for link, unit in (
+            (BOOTSTRAP_WANT, BOOTSTRAP_UNIT),
+            (PROXY_WANT, PROXY_UNIT),
+            (FIRST_LAUNCH_WANT, FIRST_LAUNCH_UNIT),
+        ):
+            with self.subTest(link=link.name):
+                self.assertTrue(link.is_symlink())
+                self.assertEqual(link.resolve(), unit.resolve())
+                self.assertTrue(unit.is_file())
+
+
+class SeededConfigTests(unittest.TestCase):
+    def test_codex_config_selects_the_openzoo_provider_at_top_level(self) -> None:
+        text = read(CODEX_CONFIG)
+        first_table = text.index("[")
+        top_level = text[:first_table]
+        self.assertTrue(has_line(top_level, 'model_provider = "openzoo"'))
+        self.assertIn("[model_providers.openzoo]", text)
+        self.assertTrue(has_line(text, 'base_url = "http://localhost:8402/v1"'))
+        self.assertTrue(has_line(text, 'env_key = "OPENZOO_API_KEY"'))
+        self.assertTrue(has_line(text, "requires_openai_auth = false"))
+
+    def test_environment_provides_the_named_key(self) -> None:
+        text = read(ENVIRONMENT_CONF)
+        self.assertTrue(has_line(text, "OPENZOO_API_KEY=sk-openzoo"))
+
